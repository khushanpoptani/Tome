# Safe private-network defaults. Do not put repository tokens or signed URLs in this file.
RUST_LOG=info
TOME_NETWORK_MODE=loopback
TOME_BIND_ADDRESS=127.0.0.1
TOME_PORT=7331
TOME_DATABASE_PATH=tome.sqlite3
TOME_TEMP_DIRECTORY=tome-temp
TOME_JOB_RETENTION_DAYS=30
# Optional absolute path to a reviewed llama-server executable.
# TOME_LLAMA_SERVER_PATH=C:\Program Files\llama.cpp\llama-server.exe
