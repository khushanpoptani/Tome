# Safe Phase 1 defaults. Do not put secrets in this file or log values that may contain them.
RUST_LOG=info
TOME_NETWORK_MODE=loopback
TOME_BIND_ADDRESS=127.0.0.1
TOME_PORT=7331
TOME_DATABASE_PATH=tome.sqlite3
TOME_TEMP_DIRECTORY=tome-temp
TOME_JOB_RETENTION_DAYS=30

# Leave false. Setting this true is an explicit acknowledgement that the unauthenticated
# Phase 1 API may bind to a wildcard or public address.
TOME_ALLOW_PUBLIC_BIND=false
