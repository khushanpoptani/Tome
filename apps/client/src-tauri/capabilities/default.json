{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Minimum desktop permissions for the Phase 3 local client and private server connections",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-message",
    "dialog:allow-save",
    {
      "identifier": "http:default",
      "allow": [{ "url": "http://*:*" }]
    }
  ]
}
